{
  "name": "auralis",
  "version": "1.0.4",
  "description": "SPMusic — không gian nghe nhạc cá nhân",
  "author": "SPMusic",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "desktop:dev": "vite build client --config client/vite.config.js && electron .",
    "desktop:deps": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare-youtube.ps1",
    "desktop:build": "npm run desktop:deps && vite build client --config client/vite.config.js && electron-builder --win --config electron-builder.yml",
    "ai:prepare": "node tools/prepare-lyrics-ai.mjs",
    "test": "npm run test -w server && node --test client/test/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@huggingface/transformers": "^4.3.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
