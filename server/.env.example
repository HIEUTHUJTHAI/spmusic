# Copy to server/.env. Empty DATABASE_URL uses persistent PostgreSQL WASM (PGlite).
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001
DATABASE_URL=
DATA_DIR=./data
NODE_ENV=development
# Set true only when serving through HTTPS.
COOKIE_SECURE=false
# Local Whisper: downloads model weights only; audio/lyrics stay on this machine.
# Default model cache: DATA_DIR/ai-models. Optional absolute alternative path:
LYRICS_AI_CACHE=
# Set true after downloading the model to prohibit remote model requests.
LYRICS_AI_OFFLINE=false
